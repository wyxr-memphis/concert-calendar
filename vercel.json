{
  "outputDirectory": "docs",
  "cleanUrls": true,
  "redirects": [
    { "source": "/calendar.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/(index\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=1800, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/thisweek.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=1800, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/(.*\\.(?:png|webp|jpg|jpeg|svg|ico))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/sponsors/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300" }
      ]
    }
  ]
}
