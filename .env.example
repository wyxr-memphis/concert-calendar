# Environment variables for local development
# Copy this file to .env and fill in your values
# Load with: source .env

# Backend API (Flask)
export DATABASE_URL="postgresql://..."  # Use Render external URL for local dev
export ADMIN_PASSWORD="your_admin_password"
export ADMIN_SECRET_KEY="your_secret_key_here"  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
export ALLOWED_ORIGINS="http://localhost:5001,http://localhost:8000,http://127.0.0.1:5001"

# Data sources
export SITEWRENCH_API_TOKEN="your_sitewrench_api_token"  # Used by Huey's scraper
export TICKETMASTER_API_KEY="your_ticketmaster_key"
export ANTHROPIC_API_KEY="your_anthropic_key"

# GitHub (for artifact uploads)
export GITHUB_PAT="your_github_personal_access_token"
export GITHUB_REPO="wyxr-memphis/concert-calendar"

# Optional: Vercel deploy hook
export VERCEL_DEPLOY_HOOK="https://api.vercel.com/v1/integrations/deploy/..."

# Slack bot (for image upload → Claude Vision pipeline)
export SLACK_BOT_TOKEN="xoxb-..."       # From api.slack.com → OAuth & Permissions
export SLACK_SIGNING_SECRET="..."       # From api.slack.com → Basic Information
export SLACK_CHANNEL_ID="C0XXXXXXXXX"  # Channel ID for #wyxr-concert-calendar
